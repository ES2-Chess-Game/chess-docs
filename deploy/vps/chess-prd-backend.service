[Unit]
Description=Produção do xadrez: API do jogo de xadrez

[Service]
WorkingDirectory=%h/chess-deploy/prod
EnvironmentFile=-%h/chess-deploy/prod/backend.env
ExecStart=%h/chess-deploy/runtime/java25/bin/java -Xmx768m -jar %h/chess-deploy/prod/current/chess-backend.jar --server.address=127.0.0.1 --server.port=28081 --server.forward-headers-strategy=framework
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
